{
  "opencollection": "1.0.0",
  "info": {
    "name": "Memfault Cloud REST Auth Cohorts API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
