                "name": "organization_slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List cohorts"
        },
        {
          "info": {
            "name": "Create a cohort",
