{
  "opencollection": "1.0.0",
  "info": {
    "name": "Memfault Cloud REST Auth Chunks API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chunks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload device chunk",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.memfault.com/api/v0/chunks/:device_serial",
            "params": [
              {
                "name": "device_serial",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Memfault-Project-Key",
              "value": "{{Memfault-Project-Key}}",
              "placement": "header"
            }
          },
          "docs": "Ingest a chunk of telemetry data from a device. Authenticated with the project key."
        }
      ]
    }
  ],
  "bundled": true
}